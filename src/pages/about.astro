---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

const competencies = [
	{ title: 'Languages', items: ['Golang', 'Java', 'Python', 'TypeScript', 'JavaScript'] },
	{ title: 'Backend Frameworks', items: ['Spring Boot', 'Echo', 'Gin', 'Express', 'FastAPI'] },
	{ title: 'Frontend', items: ['React.js', 'Next.js', 'Vite', 'NX'] },
	{ title: 'Cloud Platforms', items: ['AWS', 'GCP', 'Azure', 'On premises'] },
	{
		title: 'Databases',
		items: [
			'PostgreSQL',
			'MySQL',
			'MongoDB',
			'Redis',
			'BigQuery',
			'Bigtable',
			'Spanner',
			'Elasticsearch',
		],
	},
	{
		title: 'Messaging & Streaming',
		items: ['Kafka', 'RabbitMQ', 'Google Pub/Sub', 'AWS SQS', 'Apache Flink', 'Google Dataflow'],
	},
	{
		title: 'DevOps & CI/CD',
		items: [
			'Docker',
			'Kubernetes',
			'GitHub Actions',
			'GitLab CI',
			'ArgoCD',
			'Terraform',
			'CircleCI',
			'Jenkins',
		],
	},
	{
		title: 'Observability',
		items: ['ELK Stack', 'Datadog', 'Splunk', 'Stackdriver', 'Google Cloud Tracing'],
	},
	{
		title: 'Architecture',
		items: ['Microservices', 'Event-Driven', 'Distributed Systems', 'Serverless'],
	},
	{
		title: 'AI / Data Platform',
		items: [
			'LLM Gateway',
			'Vector Databases (Milvus)',
			'Airbyte',
			'Dagster',
			'Cube.js',
			'OpenMetadata',
			'Flowise',
			'ClickHouse',
		],
	},
	{
		title: 'Identity & Security',
		items: ['Keycloak', 'OAuth2/OIDC', 'RBAC', 'Multi-tenant isolation'],
	},
	{
		title: 'Leadership',
		items: [
			'Team Mentoring',
			'Technical Strategy',
			'Solution Architecture',
			'Code Review',
			'Agile/Scrum',
		],
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="About · Toan Nguyen"
			description="Principal Software Engineer with 10+ years architecting and scaling mission-critical distributed systems across AI, FinTech, MarTech, and Social platforms."
		/>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>Toan Nguyen</h1>
				<p class="role">Principal Software Engineer</p>
				<p class="contact">
					<a href="mailto:canhtoanptit@gmail.com">canhtoanptit@gmail.com</a>
					<span class="sep">·</span>
					<a href="https://www.linkedin.com/in/toan-n-49617866" target="_blank" rel="noopener"
						>LinkedIn</a
					>
				</p>
			</section>

			<section class="summary">
				<h2>Professional Summary</h2>
				<p>
					Principal Software Engineer with 10+ years of experience architecting, building, and
					scaling mission-critical distributed systems for world-class enterprises. Proven track
					record delivering platforms that process billions of events, hundreds of terabytes of
					data, and serve millions of users across AI Platform, FinTech, MarTech, and Social
					Platform. Deep expertise across the full software lifecycle — Backend, DevOps, Frontend,
					and Cloud infrastructure. Recognized for designing scalable microservices, mentoring
					high-performing teams, and translating complex business requirements into robust technical
					solutions.
				</p>
			</section>

			<section class="competencies">
				<h2>Core Competencies</h2>
				<div class="grid">
					{
						competencies.map((group) => (
							<article class="card">
								<h3>{group.title}</h3>
								<ul>
									{group.items.map((item) => (
										<li>{item}</li>
									))}
								</ul>
							</article>
						))
					}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		margin-bottom: 2.5rem;
	}
	.hero h1 {
		margin-bottom: 0.2rem;
	}
	.role {
		font-size: 1.25rem;
		font-weight: 700;
		color: rgb(var(--gray-dark));
		letter-spacing: 0.02em;
		text-transform: uppercase;
		margin-bottom: 0.5rem;
	}
	.contact {
		color: rgb(var(--gray));
		margin-bottom: 0;
	}
	.contact .sep {
		margin: 0 0.5rem;
		color: rgb(var(--gray));
	}
	section {
		margin-bottom: 2.5rem;
	}
	.competencies .grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
		gap: 1rem;
	}
	.card {
		border: 1px solid rgb(var(--gray-light));
		border-radius: 12px;
		padding: 1rem 1.25rem;
		background: #fff;
		box-shadow: var(--box-shadow);
	}
	.card h3 {
		font-size: 1.05rem;
		margin-bottom: 0.6rem;
		color: var(--accent);
	}
	.card ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	.card li {
		font-size: 0.85rem;
		line-height: 1.3;
		background: rgba(var(--gray-light), 60%);
		color: rgb(var(--gray-dark));
		padding: 0.2rem 0.6rem;
		border-radius: 999px;
		white-space: nowrap;
	}
</style>
